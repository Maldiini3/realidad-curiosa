---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  articleData?: {
    publishedTime?: string;
    modifiedTime?: string;
    section?: string;
    tags?: string[];
  };
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "Realidad Curiosa | Descubre lo extraordinario",
  description = "Realidad Curiosa: descubre datos sorprendentes, ciencia, naturaleza, historia y fenómenos extraordinarios.",
  image = "/assets/og-image.png",
  type = "website",
  articleData,
  schema
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.site);
const logoImageURL = new URL('/assets/logo-realidad-curiosa.png', Astro.site);

// Construcción de Schema.org estructurado
const baseGraph: Array<Record<string, unknown>> = [
  {
    "@type": "Organization",
    "@id": "https://realidadcuriosa.com/#organization",
    "name": "Realidad Curiosa",
    "url": "https://realidadcuriosa.com",
    "logo": {
      "@type": "ImageObject",
      "url": logoImageURL.toString(),
      "width": 498,
      "height": 498
    },
    "sameAs": [
      "https://www.youtube.com/@realidadcuriosaa",
      "https://www.tiktok.com/@realidad.curiosa",
      "https://www.facebook.com/people/Realidad-Curiosa/61570674806317/"
    ]
  },
  {
    "@type": "WebSite",
    "@id": "https://realidadcuriosa.com/#website",
    "url": "https://realidadcuriosa.com",
    "name": "Realidad Curiosa",
    "description": "Descubre lo extraordinario: curiosidades del universo, ciencia, naturaleza y misterios históricos.",
    "publisher": { "@id": "https://realidadcuriosa.com/#organization" },
    "inLanguage": "es"
  }
];

if (schema) {
  if (Array.isArray(schema)) {
    baseGraph.push(...schema);
  } else {
    baseGraph.push(schema);
  }
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": baseGraph
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#230b4d" />

    <!-- Título y Metadatos Principales -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Favicon y Assets de Marca -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Redes Sociales -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:site_name" content="Realidad Curiosa" />
    <meta property="og:locale" content="es_MX" />

    {type === 'article' && articleData && (
      <>
        {articleData.publishedTime && <meta property="article:published_time" content={articleData.publishedTime} />}
        {articleData.modifiedTime && <meta property="article:modified_time" content={articleData.modifiedTime} />}
        {articleData.section && <meta property="article:section" content={articleData.section} />}
        {articleData.tags?.map((t: string) => <meta property="article:tag" content={t} />)}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <!-- Enlace de salto accesible para navegación con teclado -->
    <a href="#main-content" class="skip-link">Saltar al contenido principal</a>

    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    top: -50px;
    left: 16px;
    background: var(--color-amarillo-luminoso);
    color: #12082b;
    padding: 10px 16px;
    font-size: 13px;
    font-weight: 800;
    border-radius: var(--radio-sm);
    z-index: 999;
    transition: top 0.2s ease-in-out;
  }

  .skip-link:focus {
    top: 16px;
  }
</style>

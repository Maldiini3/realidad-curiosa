---
import { verifiedVideos, type VideoPublication } from '../data/videos';

const hasVerifiedVideos = verifiedVideos.length > 0;

// Canales oficiales para descubrir contenido auténtico
const channelLinks = [
  { name: "YouTube Shorts", url: "https://www.youtube.com/@realidadcuriosaa", icon: "▶", badge: "Shorts semanales" },
  { name: "TikTok", url: "https://www.tiktok.com/@realidad.curiosa", icon: "♪", badge: "Videos cortos" },
  { name: "Facebook Reels", url: "https://www.facebook.com/people/Realidad-Curiosa/61570674806317/", icon: "f", badge: "Reels y posts" }
];
---

<section class="wrap gallery-section" id="videos" aria-labelledby="gallery-title">
  <div class="section-head center">
    <div class="kicker kicker-cyan">
      <span aria-hidden="true">&#9654;</span>
      <span>Contenido en video</span>
    </div>
    <h2 id="gallery-title" class="section-title">
      Videos destacados en <span class="gradient-text">formato vertical 9:16</span>
    </h2>
    <p class="section-sub">
      Diseñamos piezas dinámicas adaptadas al formato de las redes sociales actuales. Cada video te conecta directamente con su publicación original sin intermediarios ni reproductores pesados.
    </p>
  </div>

  {hasVerifiedVideos && (
    <div class="cards-grid">
      {verifiedVideos.map((video: VideoPublication) => (
        <article class="video-card">
          <div class="card-media">
            {video.thumbnailUrl ? (
              <img
                src={video.thumbnailUrl}
                alt={`Miniatura del video: ${video.title}`}
                class="video-thumbnail"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="thumbnail-fallback">
                <div class="fallback-glow"></div>
                <img
                  src="/assets/logo-realidad-curiosa.jpg"
                  alt="Realidad Curiosa"
                  class="fallback-logo"
                  width="72"
                  height="72"
                />
              </div>
            )}
            <div class="media-overlay"></div>
          </div>

          <div class="card-header">
            <span class="video-category">{video.category}</span>
            <span class="platform-badge">{video.platform}</span>
          </div>

          <div class="card-play-indicator" aria-hidden="true">
            <div class="play-circle">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#12082b">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
          </div>

          <div class="card-info">
            <h3 class="video-title">{video.title}</h3>
            <a
              href={video.publicationUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="watch-cta"
              aria-label={`Ver publicación individual: ${video.title} en ${video.platform} (se abre en pestaña nueva)`}
            >
              <span>Ver publicación individual</span>
              <span class="cta-arrow" aria-hidden="true">&#8599;</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  )}

  {!hasVerifiedVideos && (
    <div class="gallery-showcase-container">
      <div class="showcase-card">
        <div class="mockup-frame-wrapper">
          <div class="vertical-phone-mockup">
            <div class="mockup-screen">
              <div class="mockup-header-bar">
                <span class="mockup-live-dot"></span>
                <span>REALIDAD CURIOSA</span>
              </div>
              <div class="mockup-center-brand">
                <img
                  src="/assets/logo-realidad-curiosa.jpg"
                  alt="Logotipo oficial de Realidad Curiosa"
                  class="mockup-brand-img"
                  width="110"
                  height="110"
                />
                <span class="mockup-format-pill">Formato 9:16</span>
              </div>
              <div class="mockup-footer-info">
                <span class="mockup-tag">Ciencia & Misterios</span>
                <span class="mockup-subtext">Publicaciones individuales en preparación</span>
              </div>
            </div>
          </div>
        </div>

        <div class="showcase-content">
          <div class="kicker kicker-yellow">
            <span aria-hidden="true">&#9889;</span>
            <span>Galería en preparación</span>
          </div>
          <h3 class="showcase-heading">
            Conexión directa con nuestras publicaciones individuales
          </h3>
          <p class="showcase-text">
            Estamos preparando las miniaturas auténticas y enlaces individuales a cada publicación oficial de <strong>Realidad Curiosa</strong>. Para garantizar la máxima transparencia, <strong>no mostramos publicaciones simuladas ni estadísticas ficticias</strong>.
          </p>
          <p class="showcase-note">
            Mientras se incorporan los enlaces individuales de cada video, puedes explorar todos nuestros Shorts y Reels directamente en nuestros canales oficiales:
          </p>

          <div class="channel-pills-grid">
            {channelLinks.map(ch => (
              <a
                href={ch.url}
                target="_blank"
                rel="noopener noreferrer"
                class="channel-pill-item"
                aria-label={`Explorar videos en ${ch.name} (se abre en nueva pestaña)`}
              >
                <span class="channel-icon" aria-hidden="true">{ch.icon}</span>
                <div class="channel-texts">
                  <span class="channel-title">{ch.name}</span>
                  <span class="channel-badge-text">{ch.badge}</span>
                </div>
                <span class="channel-arrow" aria-hidden="true">&#8599;</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  )}

  <div class="gallery-privacy-notice">
    <span class="notice-icon" aria-hidden="true">&#128274;</span>
    <p>
      <strong>Privacidad y velocidad:</strong> Esta galería no incrusta iframes ni reproductores de terceros con rastreadores automáticos. Cada enlace conduce de forma segura y directa a la publicación original en su plataforma oficial.
    </p>
  </div>
</section>

<style>
  .gallery-section {
    padding: clamp(60px, 8vw, 96px) 0;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
    margin-bottom: 36px;
  }

  .video-card {
    position: relative;
    aspect-ratio: 9 / 16;
    border-radius: var(--radio-lg);
    border: 1px solid var(--color-linea-borde);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px 16px;
    background: #0d1224;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    transition: transform var(--transicion-suave), border-color var(--transicion-suave), box-shadow var(--transicion-suave);
  }

  .video-card:hover {
    transform: translateY(-8px);
    border-color: rgba(250, 204, 21, 0.5);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.65), 0 0 28px rgba(250, 204, 21, 0.2);
  }

  .card-media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .video-thumbnail {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail-fallback {
    width: 100%;
    height: 100%;
    background: radial-gradient(circle at 50% 40%, rgba(124, 58, 237, 0.4) 0%, rgba(8, 11, 26, 0.95) 85%);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .fallback-glow {
    position: absolute;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: rgba(250, 204, 21, 0.2);
    filter: blur(20px);
  }

  .fallback-logo {
    position: relative;
    z-index: 2;
    border-radius: var(--radio-sm);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);
  }

  .media-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(8, 11, 24, 0.6) 0%, rgba(8, 11, 24, 0.2) 40%, rgba(6, 9, 20, 0.92) 100%);
  }

  .card-header {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 8px;
  }

  .video-category {
    font-size: 11px;
    font-weight: 800;
    color: var(--color-blanco);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(0, 0, 0, 0.5);
    padding: 4px 8px;
    border-radius: var(--radio-xs);
    backdrop-filter: blur(4px);
  }

  .platform-badge {
    font-size: 10px;
    font-weight: 750;
    padding: 4px 8px;
    border-radius: var(--radio-full);
    background: rgba(250, 204, 21, 0.15);
    color: var(--color-amarillo-luminoso);
    border: 1px solid rgba(250, 204, 21, 0.4);
    white-space: nowrap;
  }

  .card-play-indicator {
    position: relative;
    z-index: 2;
    align-self: center;
  }

  .play-circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--color-amarillo-luminoso);
    display: grid;
    place-items: center;
    box-shadow: 0 4px 20px rgba(250, 204, 21, 0.5);
    transition: transform var(--transicion-rapida);
  }

  .video-card:hover .play-circle {
    transform: scale(1.15);
  }

  .card-info {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .video-title {
    font-size: 15px;
    font-weight: 800;
    line-height: 1.35;
    color: var(--color-blanco);
    margin: 0;
  }

  .watch-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 11px 16px;
    border-radius: var(--radio-md);
    background: var(--color-amarillo-luminoso);
    color: #12082b;
    font-size: 12.5px;
    font-weight: 800;
    transition: transform var(--transicion-rapida), filter var(--transicion-rapida);
  }

  .watch-cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }

  .cta-arrow {
    font-size: 14px;
  }

  .gallery-showcase-container {
    max-width: 980px;
    margin: 0 auto 36px;
  }

  .showcase-card {
    border: 1px solid var(--color-linea-borde);
    border-radius: var(--radio-xl);
    background: linear-gradient(145deg, rgba(22, 10, 51, 0.75) 0%, rgba(9, 13, 28, 0.92) 100%);
    box-shadow: var(--sombra-card);
    padding: clamp(28px, 5vw, 48px);
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: clamp(28px, 4vw, 52px);
    align-items: center;
  }

  .mockup-frame-wrapper {
    display: flex;
    justify-content: center;
  }

  .vertical-phone-mockup {
    width: 100%;
    max-width: 240px;
    aspect-ratio: 9 / 16;
    border-radius: 28px;
    border: 3px solid rgba(157, 140, 255, 0.35);
    background: #080b18;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.6), 0 0 28px rgba(124, 58, 237, 0.25);
    padding: 8px;
    display: flex;
  }

  .mockup-screen {
    flex: 1;
    border-radius: 20px;
    background: radial-gradient(circle at 50% 30%, rgba(35, 11, 77, 0.85) 0%, #060914 100%);
    position: relative;
    overflow: hidden;
    padding: 16px 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .mockup-header-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    font-weight: 800;
    color: var(--color-blanco-tenue);
    letter-spacing: 0.1em;
  }

  .mockup-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-amarillo-luminoso);
    box-shadow: 0 0 8px var(--color-amarillo-luminoso);
  }

  .mockup-center-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin: auto 0;
  }

  .mockup-brand-img {
    border-radius: var(--radio-md);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6), 0 0 20px rgba(250, 204, 21, 0.3);
  }

  .mockup-format-pill {
    font-size: 11px;
    font-weight: 800;
    color: var(--color-azul-cian);
    background: rgba(104, 225, 245, 0.12);
    border: 1px solid rgba(104, 225, 245, 0.3);
    padding: 4px 12px;
    border-radius: var(--radio-full);
  }

  .mockup-footer-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 10px;
  }

  .mockup-tag {
    font-size: 11px;
    font-weight: 750;
    color: var(--color-amarillo-luminoso);
  }

  .mockup-subtext {
    font-size: 10px;
    color: var(--color-texto-apagado);
  }

  .showcase-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .showcase-heading {
    font-size: clamp(22px, 3vw, 30px);
    font-weight: 850;
    line-height: 1.25;
    color: var(--color-blanco);
    margin: 8px 0 14px;
  }

  .showcase-text {
    font-size: 15px;
    color: var(--color-texto-secundario);
    line-height: 1.65;
    margin-bottom: 12px;
  }

  .showcase-text strong {
    color: var(--color-blanco);
  }

  .showcase-note {
    font-size: 14px;
    color: var(--color-blanco-tenue);
    line-height: 1.6;
    margin-bottom: 22px;
  }

  .channel-pills-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .channel-pill-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 18px;
    border-radius: var(--radio-md);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-linea-borde);
    color: var(--color-blanco);
    transition: transform var(--transicion-rapida), border-color var(--transicion-rapida), background var(--transicion-rapida);
  }

  .channel-pill-item:hover {
    transform: translateX(4px);
    border-color: var(--color-linea-activa);
    background: rgba(255, 255, 255, 0.09);
  }

  .channel-icon {
    font-size: 18px;
    color: var(--color-amarillo-luminoso);
    width: 24px;
    text-align: center;
  }

  .channel-texts {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .channel-title {
    font-size: 14px;
    font-weight: 750;
  }

  .channel-badge-text {
    font-size: 11px;
    color: var(--color-texto-secundario);
  }

  .channel-arrow {
    font-size: 16px;
    color: var(--color-azul-cian);
    transition: transform var(--transicion-rapida);
  }

  .channel-pill-item:hover .channel-arrow {
    transform: translate(2px, -2px);
    color: var(--color-amarillo-luminoso);
  }

  .gallery-privacy-notice {
    max-width: 820px;
    margin: 0 auto;
    padding: 16px 22px;
    border-radius: var(--radio-md);
    background: rgba(13, 19, 38, 0.65);
    border: 1px solid var(--color-linea-borde);
    display: flex;
    gap: 14px;
    align-items: center;
    color: var(--color-texto-secundario);
    font-size: 13px;
    line-height: 1.55;
  }

  .notice-icon {
    font-size: 18px;
    flex-shrink: 0;
  }

  .gallery-privacy-notice strong {
    color: var(--color-blanco);
  }

  @media (max-width: 900px) {
    .showcase-card {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .showcase-content {
      align-items: center;
    }

    .channel-pill-item {
      text-align: left;
    }

    .cards-grid {
      grid-template-columns: repeat(2, 1fr);
      max-width: 580px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 540px) {
    .cards-grid {
      grid-template-columns: 1fr;
      max-width: 300px;
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>

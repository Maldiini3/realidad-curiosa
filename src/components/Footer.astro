---
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();

const footerLinks = [
  { name: "Inicio", url: "/#inicio" },
  { name: "Nosotros", url: "/#nosotros" },
  { name: "Categorías", url: "/#temas" },
  { name: "Artículos", url: "/articulos/" },
  { name: "Videos", url: "/#videos" },
  { name: "Redes", url: "/#redes" }
];

const socialLinks = [
  {
    name: "YouTube",
    url: "https://www.youtube.com/@realidadcuriosaa",
    label: "Canal oficial de YouTube de Realidad Curiosa"
  },
  {
    name: "TikTok",
    url: "https://www.tiktok.com/@realidad.curiosa",
    label: "Perfil oficial de TikTok de Realidad Curiosa"
  },
  {
    name: "Facebook",
    url: "https://www.facebook.com/people/Realidad-Curiosa/61570674806317/",
    label: "Página oficial de Facebook de Realidad Curiosa"
  }
];
---

<footer class="footer" role="contentinfo">
  <!-- Separador cósmico distintivo con gradiente de luz -->
  <div class="footer-divider-glow" aria-hidden="true"></div>

  <div class="wrap footer-grid">
    <!-- Columna 1: Marca de cierre y descripción -->
    <div class="footer-col brand-col">
      <div class="footer-brand-badge">
        <span class="footer-kicker">Plataforma de Divulgación</span>
        <a href="/" class="footer-logo-link" aria-label="Realidad Curiosa — Volver arriba">
          <Logo size={34} showText={true} />
        </a>
      </div>

      <p class="footer-bio">
        Un espacio digital dedicado a explorar el asombro del universo, la naturaleza, la ciencia y los enigmas que despiertan el deseo continuo de aprender.
      </p>

      <div class="footer-social-inline">
        {socialLinks.map(soc => (
          <a
            href={soc.url}
            target="_blank"
            rel="noopener noreferrer"
            class="social-pill"
            aria-label={soc.label}
          >
            <span>{soc.name}</span>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>

    <!-- Columna 2: Navegación rápida -->
    <div class="footer-col nav-col">
      <h3 class="footer-heading">Secciones</h3>
      <ul class="footer-nav-list" role="list">
        {footerLinks.map(link => (
          <li>
            <a href={link.url} class="footer-nav-link">{link.name}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Columna 3: Información de canal -->
    <div class="footer-col channel-col">
      <h3 class="footer-heading">Canales Oficiales</h3>
      <p class="footer-note">
        Divulgación en video vertical de 9:16 y publicaciones semanales en YouTube, TikTok y Facebook.
      </p>
      <div class="domain-pill">
        <span class="pill-dot" aria-hidden="true"></span>
        <span>realidadcuriosa.com</span>
      </div>
    </div>
  </div>

  <!-- Barra inferior de copyright -->
  <div class="footer-bottom">
    <div class="wrap footer-bottom-inner">
      <p class="copyright-text">
        &copy; {currentYear} Realidad Curiosa. Todos los derechos reservados.
      </p>
      <p class="motto-text">
        Hecho para mentes curiosas.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    border-top: 1px solid var(--color-linea-borde);
    background: linear-gradient(180deg, rgba(8, 11, 24, 0.98) 0%, rgba(4, 5, 12, 1) 100%);
    padding: clamp(56px, 8vw, 84px) 0 0;
    margin-top: clamp(64px, 10vw, 110px);
  }

  /* Separador cósmico superior */
  .footer-divider-glow {
    position: absolute;
    top: -1px;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(124, 58, 237, 0.7), rgba(250, 204, 21, 0.5), transparent);
    box-shadow: 0 0 12px rgba(250, 204, 21, 0.35);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 0.8fr 1fr;
    gap: clamp(32px, 5vw, 60px);
    padding-bottom: 52px;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-brand-badge {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 16px;
  }

  .footer-kicker {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-morado-suave);
  }

  .footer-logo-link {
    display: inline-flex;
    align-items: center;
  }

  .footer-bio {
    font-size: 14px;
    color: var(--color-texto-secundario);
    line-height: 1.65;
    max-width: 440px;
    margin-bottom: 24px;
  }

  .footer-social-inline {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .social-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    min-height: 40px;
    box-sizing: border-box;
    border-radius: var(--radio-full);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--color-linea-borde);
    font-size: 12px;
    font-weight: 700;
    color: var(--color-blanco-suave);
    transition: background var(--transicion-rapida), border-color var(--transicion-rapida), color var(--transicion-rapida);
  }

  .social-pill:hover {
    background: var(--color-amarillo-luminoso);
    border-color: var(--color-amarillo-luminoso);
    color: #12082b;
  }

  .footer-heading {
    font-size: 13px;
    font-weight: 850;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-amarillo-luminoso);
    margin-bottom: 20px;
  }

  .footer-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer-nav-link {
    font-size: 14px;
    color: var(--color-texto-secundario);
    transition: color var(--transicion-rapida), transform var(--transicion-rapida);
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 8px;
    margin: 0 -8px;
    box-sizing: border-box;
    border-radius: var(--radio-sm, 6px);
  }

  .footer-nav-link:hover {
    color: var(--color-blanco);
    transform: translateX(4px);
  }

  .footer-note {
    font-size: 13.5px;
    color: var(--color-texto-secundario);
    line-height: 1.6;
    margin-bottom: 20px;
  }

  .domain-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radio-md);
    background: rgba(124, 58, 237, 0.14);
    border: 1px solid rgba(157, 140, 255, 0.28);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-azul-cian);
    width: fit-content;
  }

  .pill-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-amarillo-luminoso);
    box-shadow: 0 0 8px var(--color-amarillo-luminoso);
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    padding: 24px 0 28px;
    background: rgba(4, 5, 12, 0.98);
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-size: 13px;
    color: var(--color-texto-apagado);
  }

  .copyright-text {
    margin: 0;
  }

  .motto-text {
    margin: 0;
    color: var(--color-texto-secundario);
    font-weight: 600;
  }

  /* Adaptación visual específica para móviles */
  @media (max-width: 900px) {
    .footer {
      padding-top: 50px;
      margin-top: 60px;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .footer-brand-badge {
      align-items: flex-start;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      padding-bottom: 16px;
    }

    .footer-bottom-inner {
      flex-direction: column;
      text-align: center;
      gap: 10px;
    }
  }
</style>

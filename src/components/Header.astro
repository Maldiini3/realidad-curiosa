---
import Logo from './Logo.astro';
---

<header class="header" id="header">
  <div class="wrap nav-inner">
    <a href="/" class="brand-link" aria-label="Realidad Curiosa — Volver al inicio">
      <Logo size={40} showText={true} />
    </a>

    <!-- Navegación para pantallas medianas y grandes -->
    <nav class="navlinks-desktop" aria-label="Navegación principal">
      <a href="/#inicio" class="navlink">Inicio</a>
      <a href="/#nosotros" class="navlink">Nosotros</a>
      <a href="/#temas" class="navlink">Categorías</a>
      <a href="/articulos/" class="navlink">Artículos</a>
      <a href="/#videos" class="navlink">Videos</a>
      <a href="/#redes" class="navlink">Redes</a>
    </nav>

    <div class="nav-actions">
      <a href="/#redes" class="btn primary nav-cta">
        <span>Seguir en redes</span>
      </a>

      <!-- Botón menú móvil -->
      <button
        id="mobile-menu-btn"
        class="mobile-toggle"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>

  <!-- Menú móvil desplegable -->
  <nav id="mobile-nav" class="mobile-nav" aria-label="Navegación móvil" hidden>
    <div class="mobile-nav-inner">
      <a href="/#inicio" class="mobile-link">Inicio</a>
      <a href="/#nosotros" class="mobile-link">Nosotros</a>
      <a href="/#temas" class="mobile-link">Categorías</a>
      <a href="/articulos/" class="mobile-link">Artículos</a>
      <a href="/#videos" class="mobile-link">Videos</a>
      <a href="/#redes" class="mobile-link">Redes</a>
      <a href="/#redes" class="btn primary mobile-cta">Seguir en redes</a>
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-nav');

  if (btn && menu) {
    const closeMenu = () => {
      btn.setAttribute('aria-expanded', 'false');
      btn.classList.remove('active');
      menu.hidden = true;
    };

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      btn.classList.toggle('active', !isExpanded);
      menu.hidden = isExpanded;
    });

    // Cerrar al seleccionar cualquier enlace
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        closeMenu();
      });
    });

    // Cerrar con la tecla Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        closeMenu();
        btn.focus();
      }
    });

    // Cerrar si se redimensiona a pantalla de escritorio
    window.addEventListener('resize', () => {
      if (window.innerWidth > 860 && !menu.hidden) {
        closeMenu();
      }
    });
  }
</script>

<style>
  .header {
    height: 84px;
    border-bottom: 1px solid var(--color-linea-borde);
    background: rgba(6, 9, 19, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand-link {
    display: flex;
    align-items: center;
  }

  .navlinks-desktop {
    display: flex;
    align-items: center;
    gap: 30px;
    font-size: 14px;
    font-weight: 600;
    color: var(--color-texto-secundario);
  }

  .navlink {
    transition: color var(--transicion-rapida);
    position: relative;
    padding: 8px 0;
  }

  .navlink:hover {
    color: var(--color-blanco);
  }

  .navlink::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0%;
    height: 2px;
    background: var(--color-amarillo-luminoso);
    transition: width var(--transicion-rapida);
    box-shadow: 0 0 10px var(--color-amarillo-luminoso);
  }

  .navlink:hover::after {
    width: 100%;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .nav-cta {
    padding: 10px 18px;
    font-size: 13px;
  }

  /* Botón hamburguesa móvil */
  .mobile-toggle {
    display: none;
    width: 44px;
    height: 44px;
    padding: 10px;
    border-radius: var(--radio-sm);
    border: 1px solid var(--color-linea-borde);
    background: var(--color-panel-transparente);
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
  }

  .bar {
    width: 22px;
    height: 2px;
    background-color: var(--color-texto-principal);
    border-radius: 2px;
    transition: transform var(--transicion-rapida), opacity var(--transicion-rapida);
  }

  .mobile-toggle.active .bar:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }

  .mobile-toggle.active .bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle.active .bar:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }

  /* Menú móvil desplegable */
  .mobile-nav {
    position: absolute;
    top: 84px;
    left: 0;
    right: 0;
    background: rgba(13, 19, 38, 0.98);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--color-linea-borde);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  }

  .mobile-nav-inner {
    padding: 24px 20px 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: var(--ancho-max-contenedor);
    margin: 0 auto;
  }

  .mobile-link {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-texto-principal);
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .mobile-link:hover {
    color: var(--color-amarillo-luminoso);
  }

  .mobile-cta {
    margin-top: 10px;
    width: 100%;
    padding: 14px;
  }

  @media (max-width: 860px) {
    .navlinks-desktop,
    .nav-cta {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }
  }
</style>

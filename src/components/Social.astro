---
interface SocialPlatform {
  name: string;
  handle: string;
  url: string;
  description: string;
  badge: string;
  iconSvg: string;
  accentColor: string;
}

const socialPlatforms: SocialPlatform[] = [
  {
    name: "YouTube",
    handle: "@realidadcuriosaa",
    url: "https://www.youtube.com/@realidadcuriosaa",
    description: "Videos y Shorts semanales sobre misterios del cosmos, ciencia fascinante y datos sorprendentes.",
    badge: "Canal oficial",
    accentColor: "#ff0033",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`
  },
  {
    name: "TikTok",
    handle: "@realidad.curiosa",
    url: "https://www.tiktok.com/@realidad.curiosa",
    description: "Curiosidades rápidas, fenómenos extraños y hechos insólitos contados en menos de 60 segundos.",
    badge: "Comunidad activa",
    accentColor: "#25f4ee",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>`
  },
  {
    name: "Facebook",
    handle: "Realidad Curiosa",
    url: "https://www.facebook.com/people/Realidad-Curiosa/61570674806317/",
    description: "Reels diarios, publicaciones ilustradas e interacciones con la comunidad de mentes curiosas.",
    badge: "Página oficial",
    accentColor: "#1877f2",
    iconSvg: `<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`
  }
];
---

<section class="wrap social-section" id="redes" aria-labelledby="social-title">
  <div class="section-head center">
    <div class="kicker kicker-yellow">
      <span aria-hidden="true">🌐</span>
      <span>Nuestras comunidades</span>
    </div>
    <h2 id="social-title" class="section-title">
      Conéctate con <span class="gradient-text">Realidad Curiosa</span>
    </h2>
    <p class="section-sub">
      Publicamos contenido original en las plataformas donde ya estás. Síguenos para no perderte ningún dato sorprendente.
    </p>
  </div>

  <div class="social-grid">
    {socialPlatforms.map(platform => (
      <article class="social-card" style={`--brand-color: ${platform.accentColor};`}>
        <div class="social-header">
          <div class="social-icon" set:html={platform.iconSvg} />
          <div class="social-title-box">
            <h3 class="platform-name">{platform.name}</h3>
            <span class="platform-handle">{platform.handle}</span>
          </div>
          <span class="platform-badge">{platform.badge}</span>
        </div>

        <p class="social-desc">{platform.description}</p>

        <a
          href={platform.url}
          target="_blank"
          rel="noopener noreferrer"
          class="social-btn"
          aria-label={`Seguir a Realidad Curiosa en ${platform.name} (${platform.handle}) — Se abre en pestaña nueva`}
        >
          <span>Seguir en {platform.name}</span>
          <span class="btn-arrow" aria-hidden="true">↗</span>
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .social-section {
    padding: clamp(60px, 8vw, 96px) 0;
  }

  .social-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .social-card {
    padding: 30px 26px;
    border-radius: var(--radio-lg);
    background: linear-gradient(145deg, rgba(16, 22, 44, 0.75) 0%, rgba(9, 13, 26, 0.9) 100%);
    border: 1px solid var(--color-linea-borde);
    box-shadow: var(--sombra-card);
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: transform var(--transicion-rapida), border-color var(--transicion-rapida), box-shadow var(--transicion-rapida);
  }

  .social-card::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--brand-color);
    opacity: 0.6;
    transition: opacity var(--transicion-rapida), height var(--transicion-rapida);
  }

  .social-card:hover {
    transform: translateY(-6px);
    border-color: rgba(157, 140, 255, 0.4);
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.55);
  }

  .social-card:hover::after {
    opacity: 1;
    height: 4px;
  }

  .social-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }

  .social-icon {
    width: 52px;
    height: 52px;
    border-radius: var(--radio-md);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: grid;
    place-items: center;
    color: var(--brand-color);
    flex-shrink: 0;
  }

  .social-title-box {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .platform-name {
    font-size: 19px;
    font-weight: 800;
    color: var(--color-blanco);
    margin: 0;
  }

  .platform-handle {
    font-size: 13px;
    color: var(--color-azul-cian);
    font-weight: 600;
  }

  .platform-badge {
    margin-left: auto;
    font-size: 11px;
    font-weight: 750;
    color: var(--color-texto-apagado);
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.04);
    border-radius: var(--radio-full);
    white-space: nowrap;
  }

  .social-desc {
    font-size: 14px;
    color: var(--color-texto-secundario);
    line-height: 1.6;
    margin-bottom: 26px;
    flex: 1;
  }

  .social-btn {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    padding: 13px 20px;
    border-radius: var(--radio-md);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--color-blanco);
    font-size: 14px;
    font-weight: 750;
    transition: background var(--transicion-rapida), border-color var(--transicion-rapida), color var(--transicion-rapida), transform var(--transicion-rapida);
  }

  .social-btn:hover {
    background: var(--brand-color);
    border-color: var(--brand-color);
    color: #ffffff;
    transform: translateY(-2px);
  }

  .btn-arrow {
    font-size: 16px;
    transition: transform var(--transicion-rapida);
  }

  .social-btn:hover .btn-arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 960px) {
    .social-grid {
      grid-template-columns: 1fr;
      max-width: 520px;
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 480px) {
    .social-card {
      padding: 22px 18px;
    }

    .social-header {
      flex-wrap: wrap;
      gap: 10px;
    }

    .platform-badge {
      margin-left: 0;
      width: fit-content;
    }
  }
</style>
